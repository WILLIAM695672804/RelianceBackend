# Réglages de Reliance en production. À copier en « RelianceBackend/.env » sur
# le serveur, puis à remplir. Le script deploiement/regler.sh le fait pour vous.
#
# Les lignes marquées BLOQUANT sont vérifiées par « php artisan production:preflight »,
# qui refuse le déploiement si elles ne sont pas conformes.

APP_NAME=Reliance
APP_ENV=production                     # BLOQUANT
APP_DEBUG=false                        # BLOQUANT — sinon traces et secrets exposés
APP_KEY=                               # BLOQUANT — php artisan key:generate
APP_URL=https://reliance.the7ing.site  # BLOQUANT — doit être en https
FRONTEND_URL=https://reliance.the7ing.site  # BLOQUANT — même origine que l'API

# Domaine servi par le frontal. Lu par la composition pour compiler l'interface
# et par le fichier de site de Caddy.
DOMAINE=reliance.the7ing.site

# Le frontal est le seul à parler au monde : sans cette ligne, Laravel croit
# toutes les requêtes en clair et fabrique des liens en http.
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_LEVEL=warning                      # BLOQUANT — « debug » expose des données personnelles

# ----------------------------------------------------------------- base
# PostgreSQL avec PostGIS. DB_HOST et DB_PORT sont imposés par la composition.
DB_CONNECTION=pgsql
DB_DATABASE=reliance_db
DB_USERNAME=reliance_user
DB_PASSWORD=                           # openssl rand -hex 24

# ------------------------------------------------------- session et CSRF
# Une seule origine pour l'interface et l'API : le cookie de session suffit,
# sans CORS ni SameSite=None.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=reliance.the7ing.site
SESSION_SECURE_COOKIE=true             # BLOQUANT
SANCTUM_STATEFUL_DOMAINS=reliance.the7ing.site   # BLOQUANT — aucun domaine local

# ------------------------------------------------------- cache et files
CACHE_DRIVER=redis
QUEUE_CONNECTION=sync
REDIS_CLIENT=phpredis
REDIS_PASSWORD=null

# ------------------------------------------------------------- WebSocket
# Reverb, protocole Pusher. Les trois valeurs sont des secrets : elles
# autorisent la publication d'événements à tous les abonnés.
# PUSHER_HOST, PUSHER_PORT et PUSHER_SCHEME sont imposés par la composition
# (liaison interne, en clair, à l'intérieur du réseau des conteneurs) ;
# l'interface, elle, se connecte en wss sur le port 443 du frontal.
PUSHER_APP_ID=                         # openssl rand -hex 8
PUSHER_APP_KEY=                        # openssl rand -hex 16
PUSHER_APP_SECRET=                     # openssl rand -hex 24
PUSHER_APP_CLUSTER=mt1
BROADCAST_DRIVER=pusher

# ------------------------------------------------------------- courriel
# BLOQUANT : ni « log », ni « array », ni un hôte de bac à sable (mailpit,
# mailtrap). Sans SMTP réel, aucune vérification d'adresse ni réinitialisation
# de mot de passe ne parvient à l'utilisateur.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465                          # 465 → MAIL_ENCRYPTION=ssl, 587 → tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@the7ing.site
MAIL_FROM_NAME="${APP_NAME}"
# Facultatif : adresse des réponses, une boîte réellement relevée (ex. contact@the7ing.site).
# Sans elle, les réponses vont à no-reply, ce que les messageries jugent moins favorablement.
MAIL_REPLY_TO_ADDRESS=

# ------------------------------------------------------------- paiement
#
# Préproduction : PAIEMENT_SIMULE=true fait tourner le parcours entier sans
# compte marchand ni argent — un paiement part « en attente », comme un push
# USSD, puis se confirme au bout de PAIEMENT_SIMULE_DELAI_S secondes.
# PREPRODUCTION=true est alors exigé : un serveur qui croit encaisser et ne
# fait que simuler est la pire des pannes silencieuses.
PAIEMENT_SIMULE=true
PAIEMENT_SIMULE_DELAI_S=5
PREPRODUCTION=true

# Les trois clés deviennent BLOQUANTES dès que PAIEMENT_SIMULE vaut false.
# Sans la clé de signature, les webhooks de NotchPay sont refusés (503) et
# aucun paiement n'est jamais confirmé.
NOTCHPAY_BASE_URL=https://api.notchpay.co
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_HASH_KEY=

# ------------------------------------------------------------------ SMS
# « log » n'émet aucun SMS : avertissement, non bloquant.
SMS_DRIVER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Reliance

EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ------------------------------------------------------------- métier
REQUIRE_2FA_CLIENTS=true               # recommandé pour les actions financières
SSE_MAX_SECONDS=300

# Premier administrateur, créé par les semences.
ADMIN_EMAIL=
ADMIN_PASSWORD=
