# Gabarit de configuration. Valeurs par défaut : développement local.
# En production, voir docs/deploiement.md, puis contrôler avec : php artisan reliance:verifier-production

APP_NAME=Reliance
APP_ENV=local                       # production
APP_KEY=                            # php artisan key:generate
APP_DEBUG=true                      # false en production (bloquant)
APP_URL=http://127.0.0.1:8010       # https://api.<domaine> en production
FRONTEND_URL=http://127.0.0.1:5173  # https://<domaine> : liens de vérification et de réinitialisation

# Mandataires de confiance (IP/CIDR séparées par des virgules, ou *) si un proxy inverse précède l'application
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                     # warning en production (bloquant si debug)

DB_CONNECTION=pgsql                 # PostgreSQL avec l'extension PostGIS
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=reliance_db
DB_USERNAME=reliance_user
DB_PASSWORD=

# Sessions et Sanctum (SPA authentifiée par cookie)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null                 # .<domaine> en production
SESSION_SECURE_COOKIE=false         # true en production (bloquant)
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file                   # redis recommandé en production (jetons SSE, limiteurs)
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit                   # SMTP réel en production (bac à sable bloquant)
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@reliance.cm"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Serveur WebSocket (Laravel Reverb, protocole Pusher, port 6001). Les variables REVERB_APP_*, REVERB_HOST,
# REVERB_PORT, REVERB_SCHEME et REVERB_SERVER_PORT reprennent par défaut les valeurs PUSHER_* ci-dessous.
PUSHER_APP_ID=reliance-local
PUSHER_APP_KEY=reliance-key         # valeurs aléatoires en production
PUSHER_APP_SECRET=reliance-secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http                  # https en production
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# NotchPay (agrégateur de paiement : MoMo, Orange Money, carte)
NOTCHPAY_BASE_URL=https://api.notchpay.co
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=               # obligatoire en production
NOTCHPAY_HASH_KEY=                  # obligatoire hors local : sans elle, les webhooks sont refusés (503)

# SMS (log : journalisés sans envoi ; http : SMS_API_URL + SMS_API_KEY)
SMS_DRIVER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Reliance

# Notifications push mobiles (Expo)
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Règles métier
REQUIRE_SUBSCRIPTION=false          # référencement conditionné à un abonnement actif
REQUIRE_2FA_CLIENTS=false           # 2FA exigée des clients pour les actions financières (recommandé : true)
SSE_MAX_SECONDS=300                 # durée maximale d'une connexion SSE

# Administrateur initial (db:seed). Hors local : ADMIN_PASSWORD obligatoire, 12 caractères minimum.
ADMIN_EMAIL=admin@reliance.cm
ADMIN_PASSWORD=
